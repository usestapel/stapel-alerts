      "IssueFix": {
        "type": "object",
        "description": "``POST /issues/{id}/fix`` — the release that claims the fix.\n\nBoth fields are optional and both are recorded: a CI caller has a sha, a\nhuman closing an issue after a hotfix may only have a version, and an\nissue closed with neither is still closed — just less useful when it\nregresses and somebody asks which deploy was supposed to have fixed it.",
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 64
          },
          "sha": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "IssuePage": {
        "type": "object",
        "description": "The envelope ``GET /issues`` returns: ``{count, offset, limit, results}``.\n\nBoth the wire and the contract. The list view renders its response THROUGH\nthis serializer and declares it as the response, so the schema cannot say\n``Issue[]`` while the body carries a page — which is what 0.2.0 did, with\na hand-written ``responses=IssueSerializer(many=True)`` that the generator\nhad no way to check against the method body.\n\n``results`` is the row serializer the view resolved through its seam\n(``SerializerSeamMixin``), so a host that swaps the row shape gets the same\nenvelope around its own rows.",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          }
        },
        "required": [
          "count",
          "limit",
          "offset",
          "results"
        ]
      },
      "IssuePatchStatusEnum": {
        "enum": [
          "new",
          "fixed",
          "muted"
        ],
        "type": "string",
        "description": "* `new` - new\n* `fixed` - fixed\n* `muted` - muted"
      },
      "KindEnum": {
        "enum": [
          "exception",
          "log",
          "dlq",
          "monitoring",
          "manual"
        ],
        "type": "string",
        "description": "* `exception` - Exception\n* `log` - Log\n* `dlq` - DLQ park\n* `monitoring` - Monitoring\n* `manual` - Manual"
      },
      "LevelEnum": {
        "enum": [
          "debug",
          "info",
          "warning",
          "error",
          "fatal"
        ],
        "type": "string",
        "description": "* `debug` - Debug\n* `info` - Info\n* `warning` - Warning\n* `error` - Error\n* `fatal` - Fatal"
      },
      "PatchedIssuePatch": {
        "type": "object",
        "description": "``PATCH /issues/{id}`` — status, note, and/or the mute deadline.\n\n``muted_until`` on its own is a mute: the field has no meaning in any other\nstatus, so a patch that carries only the deadline sets ``status=muted``\n(``null`` for a mute with no deadline). With any status other than\n``muted`` the deadline is ignored and cleared.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/IssuePatchStatusEnum"
          },
          "note": {
            "type": "string"
          },
          "muted_until": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Report": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportEvent"
            }
          }
        },
        "required": [
          "events"
        ]
      },
      "ReportEvent": {
        "type": "object",
        "description": "One event in a ``POST /report`` batch — the reporter wire shape.\n\n``kind=\"monitoring\"`` is the watchdog's entry: a report that the\nmonitoring stack itself has a blind spot (a scrape gap, an exporter down,\nan alertmanager silence). It carries no traceback, so ``message`` is what\ngroups it, and ``context`` carries the specifics\n(``{\"check\": \"...\", \"target\": \"...\", \"last_scrape\": \"...\"}``).",
        "properties": {
          "message": {
            "type": "string",
            "default": ""
          },
          "trace": {
            "type": "string",
            "default": ""
          },
          "service": {
            "type": "string",
            "maxLength": 64
          },
          "level": {
            "type": "string",
            "default": "error",
            "maxLength": 16
          },
          "kind": {
            "type": "string",
            "default": "manual",
            "maxLength": 16
          },
          "environment": {
            "type": "string",
            "default": "production",
            "maxLength": 32
          },
          "release": {
            "type": "string",
            "default": "",
            "maxLength": 64
          },
          "context": {},
          "request_path": {
            "type": "string",
            "default": "",
            "maxLength": 512
          },
          "trace_id": {
            "type": "string",
            "default": "",
            "maxLength": 64
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "exc_class": {
            "type": "string",
            "default": "",
            "maxLength": 128
          }
        }
      },
      "Status295Enum": {
        "enum": [
          "new",
          "fixed",
          "regressed",
          "muted"
        ],
        "type": "string",
        "description": "* `new` - New\n* `fixed` - Fixed\n* `regressed` - Regressed\n* `muted` - Muted"
      }
    },
    "securitySchemes": {
      "JWTCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "stapel_jwt",
        "description": "JWT token stored in cookie. Login via /auth/admin/ to get the cookie."
      }
    }
  }
