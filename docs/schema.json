{
  "openapi": "3.0.3",
  "info": {
    "title": "",
    "version": "0.0.0"
  },
  "paths": {
    "/alerts/api/v1/issues": {
      "get": {
        "operationId": "alerts_api_v1_issues_list",
        "description": "``GET /alerts/api/v1/issues`` — the triage list, newest activity first.\n\n**Permissions:** `IsStaffUser`",
        "parameters": [
          {
            "in": "query",
            "name": "level",
            "schema": {
              "type": "string"
            },
            "description": "debug|info|warning|error|fatal"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            },
            "description": "Page size, 1..200; default 50. Out-of-range values are clamped and the envelope echoes the limit that was applied."
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer"
            },
            "description": "Rows to skip; default 0"
          },
          {
            "in": "query",
            "name": "open",
            "schema": {
              "type": "boolean"
            },
            "description": "Only new + regressed"
          },
          {
            "in": "query",
            "name": "service",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "schema": {
              "type": "string"
            },
            "description": "ISO-8601; last_seen >= since"
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            },
            "description": "new|fixed|regressed|muted"
          }
        ],
        "tags": [
          "alerts"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuePage"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/alerts/api/v1/issues/{issue_id}": {
      "get": {
        "operationId": "alerts_api_v1_issues_retrieve",
        "description": "``GET`` one issue with its last events; ``PATCH`` its status/note.\n\n**Permissions:** `IsStaffUser`",
        "parameters": [
          {
            "in": "path",
            "name": "issue_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "alerts"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueDetail"
                }
              }
            },
            "description": ""
          }
        }
      },
      "patch": {
        "operationId": "alerts_api_v1_issues_partial_update",
        "description": "``GET`` one issue with its last events; ``PATCH`` its status/note.\n\n**Permissions:** `IsStaffUser`",
        "parameters": [
          {
            "in": "path",
            "name": "issue_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "alerts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchedIssuePatch"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatchedIssuePatch"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatchedIssuePatch"
              }
            }
          }
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/alerts/api/v1/issues/{issue_id}/fix": {
      "post": {
        "operationId": "alerts_api_v1_issues_fix_create",
        "description": "``POST /issues/{id}/fix`` — close an issue with the release that fixed it.\n\nThe endpoint CI calls on a commit that references ``alerts:<issue-id>``,\nand the one an agent calls after a fix wave. Idempotent: fixing a fixed\nissue overwrites the version, which is what a re-deploy of a better fix\nshould do.\n\n**Permissions:** `IsStaffUser`",
        "parameters": [
          {
            "in": "path",
            "name": "issue_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "alerts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueFix"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/IssueFix"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/IssueFix"
              }
            }
          }
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/alerts/api/v1/report": {
      "post": {
        "operationId": "alerts_api_v1_report_create",
        "description": "``POST /alerts/api/v1/report`` — a batch of events from a reporter.\n\n``AllowAny`` at the DRF layer and authenticated HERE, by service key,\nbecause a reporter has no session and no JWT: it is a process, not a\nperson. The key is looked up by hash (``Service.authenticate``), so the\nplaintext never reaches a query log.\n\nA staff session is also accepted, which is what makes the endpoint\ntestable and lets an operator replay an event by hand.\n\n**Permissions:** `AllowAny`",
        "tags": [
          "alerts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            }
          },
          "required": true
        },
        "security": [
          {}
        ],
        "responses": {
          "202": {
            "description": "No response body"
          }
        }
      }
    }
  },
